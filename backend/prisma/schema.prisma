generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  Asker //Can create surveys.
  Responder //Answers all the surevy questions and can watch all the surveys.
}

model User {
  user_ID   Int      @id @default(autoincrement())
  name      String
  last_name String
  email     String   @unique
  password  String
  role      Role     @default(Responder)
  createdAt DateTime @default(now())

  //One to many realationship with Survey
  surveys      Survey[]
  //One to many realationship with Question
  questions    Question[]
  //One to many realationship with Answer
  answers      Answer[]
  //One to many realationship with VideoSurvey
  videoSurveys VideoSurvey[]

  @@map("Users")
}

model Survey {
  survey_ID   Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  //One to many realationship with Question
  questions Question[]
  //User ID for the author of the survey.
  authorID  Int
  author    User       @relation(fields: [authorID], references: [user_ID])
  //One to many realtionship with VideoSurvey table

  @@map("Surveys")
}

model Question {
  question_ID Int      @id @default(autoincrement())
  title       String
  categoty    Category
  //Relationship with Survey
  surveyID    Int
  survey      Survey   @relation(fields: [surveyID], references: [survey_ID])
  //Relationship with Answer one to many.
  answers     Answer[]
  //Relationship with User
  userID      Int
  user        User     @relation(fields: [userID], references: [user_ID])

  @@map("Questions")
}

model Answer {
  id         Int      @id @default(autoincrement())
  answer     String
  CreatedAt  DateTime @default(now())
  surveyID   Int
  //Relationship with Question
  questionID Int
  question   Question @relation(fields: [questionID], references: [question_ID])
  //Relationship with User
  userID     Int
  user       User     @relation(fields: [userID], references: [user_ID])

  @@map("Answers")
}

model VideoSurvey {
  survey_video_ID Int    @id @default(autoincrement())
  answer_link     String

  //Relationship with Survey
  surveyID Int

  //RelationShip with User
  userID Int
  user   User @relation(fields: [userID], references: [user_ID])

  //Mos harro per te bo migrations per ndryshimet e databazes.

  @@map("VideoSurveys")
}

